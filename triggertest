NUM_SAMPLES = 1250
FREQ = 60
PERIOD = math.ceil(1.0 / FREQ * 10000)

trigger_value = 0.5
trigger_type = "RE"
wave = np.zeros(NUM_SAMPLES)
double_size = np.zeros(NUM_SAMPLES * 2)
output = np.zeros(NUM_SAMPLES)
i = 0

def get_next_chunk():
    global wave
    global i
    for j in range(NUM_SAMPLES):
        wave[j] = math.sin(2 * 3.14 * FREQ * i)
        i = (i + 1)

def find_trigger_point():
    global trigger_value
    global trigger_type
    global double_size
    if trigger_type == "RE":
        for j in range(1, NUM_SAMPLES):
            if double_size[j - 1] < trigger_value and double_size[j] >= trigger_value:
                return j
    elif trigger_type == "FE":
        for j in range(1, NUM_SAMPLES):
            if double_size[j - 1] >= trigger_value and double_size[j] < trigger_value:
                return j
    elif trigger_type == "FIRST":
        for j in range(NUM_SAMPLES):
            if double_size[j] >= trigger_value:
                return j

