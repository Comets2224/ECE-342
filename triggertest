class LiveGraph(QtWidgets.QMainWindow):
    def __init__(self):
        super().__init__()
        
        global output

        # 1. Initialize the PlotWidget
        self.graphWidget = pg.PlotWidget()
        self.setCentralWidget(self.graphWidget)
        
        #self.graphWidget.setBackground('w')
        #pen = pg.mkPen(color=(255, 0, 0))
        self.data_line = self.graphWidget.plot(output, pen='y')
        
        # 2. Setup the Timer
        self.timer = QtCore.QTimer()
        self.timer.setInterval(16) # Update every 50ms
        self.timer.timeout.connect(self.update_plot_data)
        self.timer.start()

    def update_plot_data(self):

        global output
        # 3. Update data (scrolling effect)
        # self.x = self.x[1:]  # Remove the first x element
        # self.x.append(self.x[-1] + 1)  # Add a new x element
        
        # self.y = self.y[1:]  # Remove the first y element
        # self.y.append(np.random.normal())  # Add new random data
        
        # 4. Set the new data to the plot line
        global output

        get_next_chunk()
        copy(wave, double_size, 0)
        get_next_chunk()
        copy(wave, double_size, 1)

        trigger_index = find_trigger_point()
        if trigger_index is not None:
            
            output = double_size[trigger_index:trigger_index + NUM_SAMPLES:1]

        else:
            # print("The function did not trigger the set trigger.")
            pass

        self.data_line.setData(output)

app = QtWidgets.QApplication(sys.argv)
main = LiveGraph()
main.show()
sys.exit(app.exec())
